# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/bakery_menu

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Public base URL used to build the QR code / public menu link
CLIENT_URL=http://localhost:5173

# Default restaurant/bakery id created by the seed script (used to build /menu/:restaurantId)
# Leave blank; the seed script will print the generated id after seeding.
